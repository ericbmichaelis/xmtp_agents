# Slack App credentials (create at https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Channel where the bot posts recommendations
OUTPUT_CHANNEL_ID=C0XXXXXXXXX

# Optional: Web search API for X/Twitter and ecosystem scanning
TAVILY_API_KEY=tvly-your-api-key

# Schedule (cron expression, default: 9am ET weekdays)
SCAN_SCHEDULE=0 9 * * 1-5

# Timezone
TZ=America/New_York

# Logging
LOG_LEVEL=info
